{
  "name": "cybersea",
  "private": true,
  "type": "module",
  "description": "Crew website for a Rapscallion game, backed by a Google Sheet.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "node tools/dev-server.mjs",
    "check:book": "node tools/check-booktext.mjs",
    "check:book:history": "node tools/check-booktext.mjs --history",
    "e2e": "NODE_PATH=$(npm root -g) node --test --test-concurrency=1 tests/e2e/*.test.mjs"
  }
}
